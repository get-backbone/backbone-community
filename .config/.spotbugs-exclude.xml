<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude generated protobuf classes (e.g. libs/vendor/licence-runtime target/generated-sources/protobuf) -->
    <Match>
        <Package name="~io\.backbone\.core\.licence\.infrastructure\.proto" />
    </Match>
    <Match>
        <Class name="io.backbone.core.audit.api.auth.ResolutionContext"/>
        <Method name="requestContext"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
