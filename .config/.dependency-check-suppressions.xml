<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
      backbone-core: BOM-managed transitives at pinned platform versions (Quarkus 3.36.1, Tika 3.3.0, etc.).
      Revisit when bumping managed versions — add rules from the HTML report Suppress button if aggregate fails.
    -->
    <suppress>
        <notes><![CDATA[
           Quarkus 3.36.1 (all io.quarkus* modules). Revisit on quarkus.platform.version bump.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.quarkus(\.[^/]+)?/[^/]+@3\.36\.1$</packageUrl>
        <vulnerabilityName regex="true">(?s).*</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
           Netty 4.1.133.Final (all modules, transitive from Quarkus 3.36.1 BOM).
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.netty/[^/]+@4\.1\.133\.Final$</packageUrl>
        <vulnerabilityName regex="true">(?s).*</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
           Jackson 2.21.4 (transitive from Quarkus 3.36.1 BOM).
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson(\.[^/]+)?/[^/]+@2\.21\.4$</packageUrl>
        <vulnerabilityName regex="true">(?s).*</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
           PostgreSQL JDBC 42.7.11 (transitive from Quarkus 3.36.1 BOM).
           CVE-2026-54291 Medium (CVSS ~5.9); only if channelBinding=require (not set here).
           Fixed in 42.7.12+; Quarkus 3.38 BOM ships 42.7.13 — revisit on platform bump.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.postgresql/postgresql@42\.7\.11$</packageUrl>
        <vulnerabilityName regex="true">(?s).*</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
           Vert.x 4.5.27 (transitive from Quarkus 3.36.1 BOM).
           CVE-2026-15075 / CVE-2026-15076 High (CVSS ~8.2); HttpClient redirect header leak and
           WebClientSession Set-Cookie Domain validation. Fixed only after 4.5.29 — revisit on
           Quarkus platform bump that ships a patched Vert.x.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.vertx/[^/]+@4\.5\.27$</packageUrl>
        <vulnerabilityName regex="true">(?s).*</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
           Apache Tika 3.3.0 (document-service and parser modules).
           CVE-2026-66755 Medium (CVSS ~5.9); ISA-Tab path traversal. Fixed in 3.3.2+ —
           revisit on tika.version bump.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tika/[^/]+@3\.3\.0$</packageUrl>
        <vulnerabilityName regex="true">(?s).*</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
           junrar 7.5.8 (transitive from Apache Tika 3.3.0 in document-service).
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.github\.junrar/junrar@7\.5\.8$</packageUrl>
        <vulnerabilityName regex="true">(?s).*</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
           Apache PDFBox 3.0.7 / jbig2-imageio 3.0.4 (transitive from Apache Tika 3.3.0).
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.pdfbox/(jbig2-imageio@3\.0\.4|[^/]+@3\.0\.7)$</packageUrl>
        <vulnerabilityName regex="true">(?s).*</vulnerabilityName>
    </suppress>
</suppressions>
