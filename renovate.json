{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeMinor"
  ],
  "schedule": [
    "before 6am on the first day of the month"
  ],
  "enabled": true,
  "timezone": "America/Los_Angeles",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "automerge": true,
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "automergeComment": "🤖 Auto-merged by Renovate after CI checks passed",
  "dependencyDashboardAutoclose": true,
  "dependencyDashboardApproval": true,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "description": "Ignore in-repo reactor parents (not on Maven Central).",
      "enabled": false,
      "matchPackageNames": [
        "/^io\\.backbonehq:.*$/"
      ]
    },
    {
      "description": "Protobuf is pinned to Quarkus BOM (parent-first RuntimeVersion); bump only with Quarkus upgrades (see root pom protobuf.version, core/vendor README).",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "/^com\\.google\\.protobuf:/"
      ],
      "enabled": false
    },
    {
      "description": "Pinned at quarkus.platform.version 3.36.1 after parent-first protobuf / RuntimeVersion conflict; re-enable only with a deliberate Quarkus upgrade.",
      "groupName": "Quarkus platform updates",
      "matchPackageNames": [
        "/^io\\.quarkus/"
      ],
      "enabled": false
    },
    {
      "description": "One PR for CDK/infra npm dependencies.",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "infra/package.json"
      ],
      "groupName": "infra npm"
    },
    {
      "description": "One PR for Maven production scopes; Quarkus and AWS SDK stay in dedicated groups.",
      "matchManagers": [
        "maven"
      ],
      "matchDepTypes": [
        "compile",
        "runtime",
        "provided",
        "import",
        "system",
        "parent"
      ],
      "excludePackageNames": [
        "/^software\\.amazon\\.awssdk/",
        "/^io\\.quarkus/"
      ],
      "groupName": "Maven dependencies"
    },
    {
      "description": "One PR for Maven plugin / build-tooling version properties.",
      "matchManagers": [
        "maven"
      ],
      "matchPackageNames": [
        "/.*maven-plugin$/",
        "/^com\\.diffplug\\.spotless:/",
        "/^com\\.github\\.spotbugs:/",
        "/^io\\.takari\\.maven\\.plugins:/",
        "/^org\\.owasp:dependency-check-maven$/",
        "/^com\\.guardsquare:proguard-/"
      ],
      "groupName": "Maven plugins"
    },
    {
      "groupName": "AWS SDK v2 monorepo",
      "matchPackageNames": [
        "/^software\\.amazon\\.awssdk/"
      ]
    },
    {
      "description": "GitHub Actions: group and do not automerge majors.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Majors need a human; no silent platform/language jumps.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Stability: only suggest Maven versions published for a few days.",
      "matchManagers": [
        "maven"
      ],
      "minimumReleaseAge": "3 days"
    }
  ]
}
