{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeMinor",
    ":automergeBranch",
    ":prHourlyLimitNone"
  ],
  "schedule": [
    "before 6am on the first day of the month"
  ],
  "enabled": true,
  "timezone": "America/Los_Angeles",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "automerge": true,
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "automergeComment": "🤖 Auto-merged by Renovate after CI checks passed",
  "dependencyDashboardAutoclose": true,
  "packageRules": [
    {
      "enabled": false,
      "matchPackageNames": [
        "/^io\\.backbone:.*$/"
      ]
    },
    {
      "description": "Protobuf is pinned to Quarkus BOM (parent-first RuntimeVersion); bump only with Quarkus upgrades (see root pom protobuf.version, libs/licence README).",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "/^com\\.google\\.protobuf:/"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "maven"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true
    },
    {
      "description": "One Renovate PR for all CDK/infra npm dependencies (infra/package.json).",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "infra/package.json"
      ],
      "groupName": "infra npm"
    },
    {
      "description": "Single PR for Maven production-ish scopes; Quarkus and AWS SDK stay in dedicated groups below.",
      "matchManagers": [
        "maven"
      ],
      "matchDepTypes": [
        "compile",
        "runtime",
        "provided",
        "import",
        "system",
        "parent"
      ],
      "excludePackageNames": [
        "/^software\\.amazon\\.awssdk/",
        "/^io\\.quarkus/"
      ],
      "groupName": "Maven dependencies"
    },
    {
      "groupName": "AWS SDK v2 monorepo",
      "matchPackageNames": [
        "/^software\\.amazon\\.awssdk/"
      ]
    },
    {
      "groupName": "Quarkus platform updates",
      "matchPackageNames": [
        "/^io\\.quarkus/"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Stability: only suggest Maven versions that have been published for a few days (avoids Maven Central vs other repos lag)",
      "matchManagers": ["maven"],
      "minimumReleaseAge": "3 days"
    }
  ]
}
