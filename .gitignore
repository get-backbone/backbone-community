# macOS
.DS_Store

# Compiled class file
target/
*.class

# Log file
logs/
*.log

# IntelliJ
.idea/*
*.iml

# Cursor IDE
.cursor

# Ignore all .vscode files
.vscode/*

# Except shared config files
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Checked-in jars under core-only tooling trees (not on client mirrors)
!libs/tools/obfuscator/*.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# local .env file (only)
.envrc.local

# local data/cache files
.floci/
.localstack/
.postgres/
.prometheus/data/
.grafana/data/
.dependency-check-cache/
.quarkus/
.clover/
shellcheck-v*/

# Infra (CDK / Node)
infra/node_modules/
infra/dist/
infra/cdk.out/
infra/reports/

infra/attest/node_modules/
infra/attest/dist/
infra/attest/cdk.out/
infra/attest/reports/
