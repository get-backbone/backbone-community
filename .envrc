# Java 24+: jboss-threads ThreadLocalResettingRunnable (quarkus CLI does not always inherit runner Add-Opens).
# javax.xml.accessExternalSchema: same as .mvn/jvm.config (Maven without direnv still uses jvm.config).
# Use --add-opens=… (equals form): space form breaks under JAVA_TOOL_OPTIONS / Maven.
export JAVA_TOOL_OPTIONS="--add-opens=java.base/java.lang=ALL-UNNAMED -Djavax.xml.accessExternalSchema=all ${JAVA_TOOL_OPTIONS:-}"

# Local secrets and overrides (gitignored)
# Node.js for CDK lives in infra/.envrc.
watch_file .envrc.local
source_env_if_exists .envrc.local
